{
  "name": "gabrielefantini.github.io",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Personal website of Gabriele Fantini",
  "scripts": {
    "dev": "vite",
    "art": "node scripts/generate-art.mjs",
    "typecheck": "tsc --noEmit",
